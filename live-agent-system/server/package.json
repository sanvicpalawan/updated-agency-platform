{
  "name": "core-agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend agent runtime for CORE: Express API + SQLite persistence + local agent decision layer.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve:built": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "reset": "tsx src/db/seed.ts --reset",
    "verify": "tsx test/e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.19.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
